{
  "name": "emoji-remotion-example",
  "version": "1.0.0",
  "private": true,
  "description": "Esempio minimo: un'emoji animata Telegram (Lottie JSON) in Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Emoji out/still.png --frame=30",
    "render": "remotion render src/index.ts Emoji out/emoji.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/lottie": "4.0.545",
    "lottie-web": "^5.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
